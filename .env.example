# Shopify App Credentials (Lấy từ Shopify Partners Dashboard hoặc Shopify CLI)
SHOPIFY_API_KEY="your_shopify_api_key"
SHOPIFY_API_SECRET="your_shopify_api_secret"
SHOPIFY_APP_URL="https://your-tunnel-or-domain.ngrok-free.app"
SCOPES="read_products,write_products,read_orders,write_orders,read_themes,write_themes"

# Database connection string (SQLite cho local dev, PostgreSQL / Supabase cho production)
DATABASE_URL="file:./dev.db"

# Node Environment
NODE_ENV="development"
